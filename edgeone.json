{
  "buildCommand": "npm run build --prefix webui -- --outDir ../static/admin --emptyOutDir",
  "installCommand": "npm ci --prefix webui",
  "rewrites": [
    {
      "source": "/v1/chat/completions",
      "has": [
        {
          "type": "query",
          "key": "__go"
        }
      ],
      "destination": "/cloud-functions/index"
    },
    {
      "source": "/v1/chat/completions",
      "destination": "/cloud-functions/api/chat-stream"
    }
  ],
  "cloudFunctions": {
    "nodejs": {
      "maxDuration": 120
    },
    "go": {
      "maxDuration": 120
    }
  }
}